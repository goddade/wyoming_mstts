[Unit]
Description=wyoming local ms text to speech
After=network.target

[Service]
ExecStart=/bin/bash /PATH/TO/WYOMING_MSTTS/run.sh
WorkingDirectory=/PATH/TO/WYOMING_MSTTS
User=USER
Group=GROUP
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=wyoming_mstts_service

[Install]
WantedBy=multi-user.target
